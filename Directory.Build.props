<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>$(MSBuildProjectName)</RootNamespace>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <AnalysisLevel>6.0</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors Condition=" '$(Configuration)' == 'RELEASE' ">true</TreatWarningsAsErrors>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    </PropertyGroup>

    <PropertyGroup>
        <ProjectVersion>1.0</ProjectVersion>
        <ConsoloniaVersion>12.1.4</ConsoloniaVersion>
        <ConsoloniaVersionLatest>$(ConsoloniaVersion).*</ConsoloniaVersionLatest>
        <!--If ran not by pipeline - defining for local run-->
        <BUILD_VERSION Condition="'$(BUILD_VERSION)' == ''">0</BUILD_VERSION>
        <VersionPrefix>$(ProjectVersion).$(BUILD_VERSION)</VersionPrefix>
        <AvaloniaVersion>12.1.4</AvaloniaVersion>
        <AvaloniaControlsDataGridVersion>12.1.2</AvaloniaControlsDataGridVersion>
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup>
        <Authors>Evgeny Gorbovoy</Authors>
        <Copyright>© 2026 Evgeny Gorbovoy</Copyright>
        <ProjectUrl>https://github.com/jinek/bashka</ProjectUrl>
        <RepositoryUrl>https://github.com/jinek/bashka</RepositoryUrl>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <IsPackable>False</IsPackable>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(SolutionDir)/../Icon.png"
              Pack="True"
              PackagePath="\" />
        <None Include="readme.md"
              Pack="true"
              PackagePath="\" />
    </ItemGroup>

    <PropertyGroup>
        <WeaverConfiguration>
            <Weavers>
                <PropertyChanged>
                    <NotifyForAllPublicProperties>true</NotifyForAllPublicProperties>
                </PropertyChanged>
            </Weavers>
        </WeaverConfiguration>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PropertyChanged.Fody"
                          Version="4.1.0"
                          PrivateAssets="All" />
    </ItemGroup>

</Project>