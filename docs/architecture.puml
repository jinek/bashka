@startuml Bashka
!theme plain
skinparam backgroundColor #0f1117
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #e6edf3
skinparam ArrowColor #8b949e
skinparam ArrowFontColor #c9d1d9
skinparam ArrowFontSize 11
skinparam componentStyle rectangle

skinparam package {
    BackgroundColor #161b22
    BorderColor #30363d
    FontColor #e6edf3
    FontStyle bold
}

skinparam component {
    BorderColor #ffffff00
    FontColor #0f1117
    RoundCorner 12
}

title Bashka — Target Modular Architecture

package "App layer" as AppLayer #161b22 {
    component "Program / App\n(bootstrap)" as Program #58a6ff
    component "PluginLoader" as PluginLoader #58a6ff
}

package "Orthodox plugin (default host)" as Orthodox #161b22 {
    component "CommanderEngine\n(was MalinaNavigator)" as CommanderEngine #3fb950
    component "Panel\n(was MalinaPanel)" as Panel #3fb950
    component "FToolBox" as FToolBox #3fb950
    component "KeyBindingService" as KeyBindingService #3fb950
    component "DialogProvider" as DialogProvider #3fb950
    component "ProgressViewModel" as ProgressViewModel #3fb950
    component "CommandExecutionContext" as CommandExecutionContext #3fb950
}

package "Foundation (default features)" as Foundation #161b22 {
    component "FSCatalog" as FSCatalog #d29922
    component "ShellCatalog\n(abstract)" as ShellCatalog #d29922
    component "SFTPCatalog" as SFTPCatalog #d29922
    component "ArchiveCatalog" as ArchiveCatalog #d29922
    component "RootsCatalog" as RootsCatalog #d29922
    component "Entry" as Entry #d29922
    component "BashExecutor" as BashExecutor #d29922
    component "ShellSession" as ShellSession #d29922
    component "SftpSession" as SftpSession #d29922
    component "CatalogCommand\n(+ Copy/Delete/Mkdir/...)" as CatalogCommand #d29922
}

package "Core (contracts + base classes)" as Core #161b22 {
    interface "ICatalog" as ICatalog #f778ba
    interface "ICommand" as ICommand #f778ba
    interface "ICommandSelector" as ICommandSelector #f778ba
    interface "IUiRoot" as IUiRoot #f778ba
    interface "IMalinaPanel" as IMalinaPanel #f778ba
    interface "IShellConnection" as IShellConnection #f778ba
    interface "IArchiveCatalog" as IArchiveCatalog #f778ba
    interface "IReadStreamCatalog" as IReadStreamCatalog #f778ba
    interface "IDialogProvider" as IDialogProvider #f778ba
    interface "IProgressShower" as IProgressShower #f778ba
    interface "ITypeKeyedObject" as ITypeKeyedObject #f778ba
    component "BaseObject" as BaseObject #f778ba
    component "TypeKeyedObject" as TypeKeyedObject #f778ba
}

folder "3rd-party Plugins\n(*.dll)" as Plugins #a371f7

Program --> PluginLoader : instantiates at startup
Program --> CommanderEngine : resolves IUiRoot
Plugins .right.> PluginLoader : discovered by

CommanderEngine --> Panel : instantiates 2 panels
CommanderEngine --> FToolBox : owns ToolBox
CommanderEngine --> KeyBindingService : forwards key events to
CommanderEngine --> DialogProvider : shows dialogs through
FToolBox --> CommandExecutionContext : builds per-slot context for
FToolBox ..> ICommandSelector : picks command for slot
KeyBindingService --> ICommand : resolves keyed command,\ninvokes Execute()

Panel --> FSCatalog : navigates/lists entries in
Panel --> SFTPCatalog : navigates/lists entries in
Panel --> ArchiveCatalog : navigates/lists entries in
Panel --> RootsCatalog : navigates/lists entries in
FSCatalog ..> ShellCatalog : derives
ShellCatalog --> ShellSession : auto-wires,\nruns scripts through
ShellSession --> BashExecutor : picks as best-match\nIScriptExecutor for script
SFTPCatalog --> SftpSession : opens SFTP connection via
ArchiveCatalog --> Entry : wraps archive items as
FSCatalog --> Entry : wraps directory listing as
CatalogCommand ..|> ICommand
CatalogCommand --> ICatalog : executes against
ProgressViewModel ..|> IProgressShower
DialogProvider ..|> IDialogProvider

CommanderEngine ..|> IUiRoot
Panel ..|> IMalinaPanel
ShellCatalog ..|> ICatalog
SFTPCatalog ..|> ICatalog
SFTPCatalog ..|> IReadStreamCatalog
ArchiveCatalog ..|> IArchiveCatalog
ArchiveCatalog ..|> IReadStreamCatalog
FToolBox ..|> ICommand
BashExecutor --> IShellConnection : writes command,\nreads output lines via
TypeKeyedObject ..|> ITypeKeyedObject
ICatalog --|> ITypeKeyedObject : extends

CommanderEngine ..> BaseObject : derives
Panel ..> BaseObject : derives
FToolBox ..> BaseObject : derives
KeyBindingService ..> BaseObject : derives
ShellCatalog ..> BaseObject : derives
SFTPCatalog ..> BaseObject : derives
ArchiveCatalog ..> BaseObject : derives
ShellSession ..> BaseObject : derives

@enduml
