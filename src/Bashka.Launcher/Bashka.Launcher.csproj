<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DefineConstants>$(DefineConstants);HANDLE_CRASH</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.0.2" />
        <PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaControlsDataGridVersion)" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20" />
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
        <PackageReference Include="Xaml.Behaviors" Version="12.0.0" />
        <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Consolonia" Version="$(ConsoloniaVersionLatest)" />        
        <PackageReference Include="Consolonia.Modal" Version="$(ConsoloniaVersionLatest)" />
        <PackageReference Include="Consolonia.Fonts" Version="$(ConsoloniaVersionLatest)"/>
        <PackageReference Include="Consolonia.Controls.DataGrid" Version="$(ConsoloniaVersionLatest)"/>
        <PackageReference Include="DynamicData" Version="9.4.33" />
        <PackageReference Include="AsyncLocalRegion" Version="2.1.0.25" />
        <PackageReference Include="Autofac" Version="9.3.2" />
        <PackageReference Include="Autofac.Extras.AttributeMetadata" Version="7.0.0" />
        <PackageReference Include="Autofac.Extras.DynamicProxy" Version="8.1.0" />

        <PackageReference Include="ini-parser-netstandard" Version="2.5.3"/>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
    </ItemGroup>
       
    <ItemGroup>
      <ProjectReference Include="..\Bashka.Plugins\Bashka.Plugins.csproj" />
      <ProjectReference Include="..\Bashka.Helpers\Bashka.Helpers.csproj" />
      <ProjectReference Include="..\Bashka.Plugins.Archives\Bashka.Plugins.Archives.csproj" />
      <ProjectReference Include="..\Bashka.Plugins.Archives.Bsdtar\Bashka.Plugins.Archives.Bsdtar.csproj" />
      <ProjectReference Include="..\Bashka.Plugins.Core\Bashka.Plugins.Core.csproj" />
      <ProjectReference Include="..\Bashka.Plugins.Foundation\Bashka.Plugins.Foundation.csproj" />
      <ProjectReference Include="..\Bashka.Plugins.Market\Bashka.Plugins.Market.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="Bashka.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../Bashka.Plugins.Core/keybindings.ini" Pack="true"
              PackagePath="contentFiles/any/any/" PackageCopyToOutput="true" PackageFlatten="true" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Program.container.cs">
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="Program.error.cs">
        <DependentUpon>Program.cs</DependentUpon>
      </Compile>
      <Compile Update="App.error.cs">
        <DependentUpon>App.cs</DependentUpon>
      </Compile>
    </ItemGroup>

</Project>
