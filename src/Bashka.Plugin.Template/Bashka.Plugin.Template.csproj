<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <!--Bashka will search for this assembly by NUGET package name-->
        <PackageId>$(AssemblyName)</PackageId>
        <Version>1.0.0</Version>
        <Description>A Bashka plugin with a visual extension and a Hello world command.</Description>
        <!--Bashka will search for plugin by this tag-->
        <PackageTags>bashka-plugin</PackageTags>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <UseAppHost>false</UseAppHost>
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Bashka.Plugins" Version="BASHKA_VERSION" ExcludeAssets="runtime" />
        <PackageReference Include="Bashka.Launcher" Version="BASHKA_VERSION" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <None Update="readme.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
