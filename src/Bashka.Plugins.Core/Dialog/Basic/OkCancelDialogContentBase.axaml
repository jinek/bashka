<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:basic="clr-namespace:Bashka.Plugins.Core.Dialog.Basic"
                    xmlns:helpers="clr-namespace:Bashka.Plugins.Core.Orthodox.UI.Helpers">
    <helpers:AppResourcesTemplateSelectorByType x:Key="AppResourcesTemplateSelectorByType" />
    <DataTemplate DataType="{x:Type basic:OkCancelDialogContentBase}"
                  x:Key="{x:Type basic:OkCancelDialogContentBase}">
        <StackPanel Orientation="Vertical">
            <ContentControl Content="{Binding Content}"
                            ContentTemplate="{Binding ContentType, Converter={StaticResource AppResourcesTemplateSelectorByType}}" />
            <Border Height="1"
                    BorderBrush="{DynamicResource ThemeBorderBrush}"
                    BorderThickness="1"
                    Margin="-1,0" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,-1"
                        Spacing="1">
                <Button Command="{Binding Ok}"
                        IsDefault="True"
                        MinWidth="9"
                        IsEnabled="{Binding Content.IsOkEnabled}"
                        IsVisible="{Binding Content.IsOkVisible}"
                        Content="Ok" />
                <Button Command="{Binding Cancel}"
                        IsCancel="True"
                        Content="{Binding Content.CancelText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type basic:QuestionDialog}"
                  x:Key="{x:Type basic:QuestionDialog}">
        <TextBlock Text="{Binding Question}"
                   TextWrapping="Wrap"
                   Margin="1,0,1,0" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type basic:ErrorDialog}"
                  x:Key="{x:Type basic:ErrorDialog}">
        <TextBlock Text="{Binding Error}"
                   TextWrapping="Wrap" />
    </DataTemplate>
</ResourceDictionary>