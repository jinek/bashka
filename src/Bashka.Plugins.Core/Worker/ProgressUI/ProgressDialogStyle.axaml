<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modal="clr-namespace:Consolonia.Modal;assembly=Consolonia.Modal">
    <Style Selector="modal|ModalWindow.centered">
        <Style.Setters>
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style.Setters>
    </Style>

    <Style Selector="modal|ModalWindow.normal_background">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{DynamicResource ThemeBackgroundBrush}" />
        </Style.Setters>
    </Style>
    
    <Style Selector="modal|ModalWindow.error_background">
        <Style.Setters>
            <Setter Property="Background"
                    Value="{DynamicResource ThemeErrorBrush}" />
        </Style.Setters>
    </Style>
    
    <Style Selector="modal|ModalWindow.min_size">
        <Style.Setters>
            <Setter Property="MinWidth"
                    Value="50" />
            <Setter Property="MinHeight"
                    Value="4" />
        </Style.Setters>
    </Style>

    <Style Selector="modal|ModalWindow.negative_padding">
        <Setter Property="Padding"
                Value="-1,0" />
    </Style>
</Styles>