<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brushes="https://github.com/consolonia"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:core="clr-namespace:Bashka.Plugins.Core.Abstract;assembly=Bashka.Plugins.Core"
                    xmlns:data="clr-namespace:Bashka.Plugins.Core.Abstract.Data"
                    xmlns:helpers1="clr-namespace:Bashka.Plugins.Core.Orthodox.UI.Helpers"
                    xmlns:ui="clr-namespace:Bashka.Plugins.Core.Orthodox.UI">
    <helpers1:EqualsConverter x:Key="EqualsConverter" />
    <helpers1:MarkedEntriesSummaryConverter x:Key="MarkedEntriesSummaryConverter" />
    <x:Int32 x:Key="Zero">0</x:Int32>

    <DataTemplate DataType="{x:Type core:IPanel}"
                  x:Key="{x:Type core:IPanel}">
        <Grid RowDefinitions="* Auto"
              Classes="Bashka Panel"
              Classes.NoMarked="{Binding MarkedEntries.Count, Converter={StaticResource EqualsConverter}, ConverterParameter={StaticResource Zero}}">
            <Grid.Styles>
                <StyleInclude Source="avares://Bashka.Plugins.Core/Orthodox/UI/PanelStyles.axaml" />
                <Style Selector="brushes|CaretControl">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Grid Background="{TemplateBinding Background}">
                                <!--todo: tune core template not to override the template, but just adjust style of the Line inside-->
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter>
                </Style>
            </Grid.Styles>

            <!--Catalog datagrid-->
            <helpers1:VerticalScrollDataGrid Grid.Row="0"
                                             ItemsSource="{Binding CurrentChildren}"
                                             SelectedItem="{Binding SelectedEntry}"
                                             SelectedIndex="{Binding SelectedIndex}"
                                             RowBackground="{DynamicResource ThemeBackgroundBrush}"
                                             AutoGenerateColumns="False"
                                             SelectionMode="Single"
                                             IsReadOnly="True"
                                             d:DataContext="{d:DesignInstance core:IPanel}">
                <Interaction.Behaviors>
                    <helpers1:OrthodoxColumnsBehavior />
                    <!--<helpers1:PagingScrollBehavior/>-->
                    <EventTriggerBehavior EventName="GotFocus">
                        <ChangePropertyAction PropertyName="IsFocused"
                                              Value="True"
                                              TargetObject="{Binding}" />
                    </EventTriggerBehavior>
                    <EventTriggerBehavior EventName="LostFocus">
                        <ChangePropertyAction PropertyName="IsFocused"
                                              Value="False"
                                              TargetObject="{Binding}" />
                    </EventTriggerBehavior>
                    <DataTriggerBehavior Binding="{Binding IsFocused, Mode=OneWay}"
                                         Value="True">
                        <FocusControlAction />
                    </DataTriggerBehavior>
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <helpers1:ScrollIntoViewAction />
                    </EventTriggerBehavior>
                    <helpers1:FocusOnEnabledAndIsFocusedBehavior />
                    <helpers1:PageNavigationBehavior />
                </Interaction.Behaviors>
                <DataGrid.KeyBindings>
                    <KeyBinding Command="{Binding EntrySelected}"
                                Gesture="ENTER" />
                </DataGrid.KeyBindings>
                <DataGrid.BorderBrush>
                    <brushes:LineBrush LineStyle="DoubleLine"
                                       Brush="{DynamicResource ThemeBorderBrush}" />
                </DataGrid.BorderBrush>
            </helpers1:VerticalScrollDataGrid>

            <!--Roots-->
            <Panel HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   MinWidth="12"
                   MaxWidth="60"
                   Margin="5,0">
                <ComboBox ItemsSource="{Binding Roots}"
                          SelectedItem="{Binding SelectedRoot}"
                          IsDropDownOpen="{Binding IsRootsVisible, Mode=TwoWay}"
                          IsTabStop="False"
                          x:Name="RootsComboBox">
                    <Interaction.Behaviors>
                        <DataTriggerBehavior Binding="{Binding IsRootsVisible}"
                                             Value="True">
                            <FocusControlAction />
                            <helpers1:FocusSelectedItemIfAnyViaDispatcherAction />
                        </DataTriggerBehavior>
                    </Interaction.Behaviors>
                    <!--<ComboBox.KeyBindings>
                    <KeyBinding Gesture="Enter"
                                Command="{Binding RootSelected}" />
                </ComboBox.KeyBindings>-->
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="data:Entry">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border BorderThickness="0"
                        IsHitTestVisible="False"
                        VerticalAlignment="Bottom"
                        MinWidth="3"
                        Margin="0,0,1,0">
                    <ui:MiddleTrimmedTextBlock Margin="1,0"
                                               HorizontalAlignment="Center"
                                               MinWidth="1"
                                               Foreground="{Binding ElementName=RootsComboBox, Path=Foreground}">
                        <ui:MiddleTrimmedTextBlock.FullText>
                            <Binding Path="CurrentCatalog.Title"
                                     FallbackValue="Select a catalog" />
                        </ui:MiddleTrimmedTextBlock.FullText>
                    </ui:MiddleTrimmedTextBlock>
                </Border>
            </Panel>

            <!--Selected Item info-->
            <Border Grid.Row="1"
                    Margin="0,-1,0,0"
                    BorderThickness="1">
                <Border.BorderBrush>
                    <brushes:LineBrush Brush="{DynamicResource ThemeBorderBrush}"
                                       LineStyle="DoubleLine" />
                </Border.BorderBrush>
                <Panel>
                    <TextBlock Classes="Bashka MarkedSummary"
                               Text="{Binding MarkedEntries, Converter={StaticResource MarkedEntriesSummaryConverter}}" />
                    <DockPanel LastChildFill="True"
                               Classes="Bashka EntryInfo">
                        <ItemsControl DockPanel.Dock="Right"
                                      ItemsSource="{Binding SelectedEntry.Details}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="1,0,0,0"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SelectedEntry.Path}" />
                    </DockPanel>
                </Panel>
            </Border>

            <!--ShellConnection Info-->
            <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
            <Border BorderThickness="0"
                    Background="{DynamicResource ThemeBackgroundBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    IsVisible="{Binding CurrentCatalog.ShellSession.ShellConnection, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                <TextBlock Margin="1,0"
                           Classes="Bashka ShellConnectionInfo"
                           d:DataContext="{x:Type core:IPanel}"
                           x:DataType="core:IPanel"
                           Text="{Binding  CurrentCatalog.ShellSession.ShellConnection.Title}" />
            </Border>
            <!--Quick search-->
            <Panel Grid.RowSpan="2"
                   IsVisible="{Binding IsQuickSearchActive}"
                   Background="{DynamicResource ThemeAlternativeBackgroundBrush}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,1,1,1">
                <Panel>
                    <Border Margin="1,0"
                            BorderThickness="1">
                        <Border.BorderBrush>
                            <brushes:LineBrush Brush="{DynamicResource ThemeBorderBrush}"
                                               LineStyle="DoubleLine" />
                        </Border.BorderBrush>
                        <TextBox Text="{Binding QuickSearchPattern, Mode=TwoWay}"
                                 MinWidth="15"
                                 MaxWidth="25"
                                 Margin="1,0"
                                 IsTabStop="False">
                            <Interaction.Behaviors>
                                <DataTriggerBehavior Binding="{Binding IsQuickSearchActive}"
                                                     Value="True">
                                    <FocusControlAction />
                                </DataTriggerBehavior>
                                <EventTriggerBehavior EventName="LostFocus">
                                    <ChangePropertyAction PropertyName="IsQuickSearchActive"
                                                          Value="False"
                                                          TargetObject="{Binding}" />
                                </EventTriggerBehavior>
                                <helpers1:QuickSearchBehavior />
                            </Interaction.Behaviors>
                        </TextBox>
                    </Border>
                    <TextBlock Text=" Search "
                               ClipToBounds="False"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               ZIndex="100" />
                </Panel>
            </Panel>
        </Grid>

    </DataTemplate>
</ResourceDictionary>