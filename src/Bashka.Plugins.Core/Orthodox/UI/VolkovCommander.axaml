<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                    xmlns:helpers="https://github.com/consolonia"
                    xmlns:core="clr-namespace:Bashka.Plugins.Core.Abstract;assembly=Bashka.Plugins.Core"
                    xmlns:orthodox="clr-namespace:Bashka.Plugins.Core.Orthodox;assembly=Bashka.Plugins.Core"
                    xmlns:helpers1="clr-namespace:Bashka.Plugins.Core.Orthodox.UI.Helpers"
                    xmlns:ui="clr-namespace:Bashka.Plugins.Core.Orthodox.UI"
                    xmlns:functionKeys="clr-namespace:Bashka.Plugins.Core.FunctionKeys">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Bashka.Plugins.Core/Orthodox/UI/Panel.axaml" />
        <ResourceInclude Source="Commander.SortingMenu.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <helpers1:KeyEventToModelConverter x:Key="KeyEventToModelConverter" />
    
    <!--https://www.mikrocontroller.net/attachment/483578/Turbo_Vision.gif-->
    <!--<system:Double x:Key="FontSizeNormal">1</system:Double>-->
    <DataTemplate DataType="{x:Type orthodox:OrthodoxCommander}"
                  x:Key="{x:Type core:IUIRoot}">
        <Panel>
            <Grid ColumnDefinitions="*,*"
                  KeyboardNavigation.TabNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="1" />
                </Grid.RowDefinitions>
                <Interaction.Behaviors>
                    <helpers1:MomentaryFunctionPageBehavior />
                    <KeyDownEventTrigger>
                        <InvokeCommandAction PassEventArgsToCommand="True"
                                             InputConverter="{StaticResource KeyEventToModelConverter}"
                                             Command="{Binding KeyDownCommand}"/>
                    </KeyDownEventTrigger>
                </Interaction.Behaviors>
                <Menu Grid.Row="0"
                      Grid.ColumnSpan="2"
                      IsTabStop="False">
                    <Interaction.Behaviors>
                        <helpers1:OrthodoxMenuBehavior />
                    </Interaction.Behaviors>
                    <MenuItem Header="Left"
                              IsTabStop="False"
                              x:Name="PART_LeftMenuItem">
                        <ui:SortingMenuItem DataContext="{Binding LeftPanel}"/>
                        <MenuItem Header="NotSorting"></MenuItem>
                    </MenuItem>
                    <MenuItem Header="Files" IsTabStop="False"/>
                    <MenuItem Header="Commands" IsTabStop="False"/>
                    <MenuItem Header="Options" IsTabStop="False"/>
                    <MenuItem Header="Right" IsTabStop="False"
                              x:Name="PART_RightMenuItem">
                        <ui:SortingMenuItem DataContext="{Binding RightPanel}"/>
                    </MenuItem>
                </Menu>
                <ContentControl Grid.Row="1"
                                Content="{Binding LeftPanel}"
                                ContentTemplate="{StaticResource {x:Type core:IPanel}}"/>
                <ContentControl Grid.Row="1"
                                Grid.Column="1"
                                Content="{Binding RightPanel}"
                                ContentTemplate="{StaticResource {x:Type core:IPanel}}" />

                <Border Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="2"
                        Height="1"
                        BorderThickness="0"
                        >
                    <Panel>
                        <TextBlock
                            Text="{Binding Path = CurrentPanel.CurrentCatalog.CurrentPath, Mode=OneWay, FallbackValue='>', StringFormat='{}{0}/>'}"/>
                    </Panel>
                </Border>

                <ItemsRepeater ItemsSource="{Binding FunctionBar.CurrentPage.Items}"
                               Grid.Column="0"
                               Margin="0,0,-1,-1"
                               Grid.ColumnSpan="2"
                               Grid.Row="3">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate DataType="functionKeys:FunctionBarItem">
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="{Binding Number}" 
                                           DockPanel.Dock="Left" />
                                <Button Content="{Binding CurrentCommandWrapper.Name}"
                                        Command="{Binding Path=Execute}"
                                        HorizontalContentAlignment="Left"
                                        Focusable="False"
                                        ClipToBounds="True"
                                        IsEnabled="{Binding CurrentCommandWrapper.CanExecute}"
                                        IsTabStop="False">
                                    <Interaction.Behaviors>
                                        <DataTriggerBehavior
                                            Binding="{Binding CurrentCommandWrapper.IsDelete}"
                                            Value="True">
                                            <DataTriggerBehavior.Actions>
                                                <ChangePropertyAction PropertyName="Background"
                                                                      Value="{DynamicResource ThemeErrorBrush}" />
                                            </DataTriggerBehavior.Actions>
                                        </DataTriggerBehavior>
                                    </Interaction.Behaviors>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="(helpers:ButtonExtensions.Shadow)"
                                                    Value="False" />
                                            <Setter Property="Margin"
                                                    Value="0,0,0,0" />
                                            <Setter Property="Padding" Value="-1,0"/>
                                        </Style>
                                        <Style Selector="Button /template/ helpers|SymbolsControl">
                                            <Setter Property="IsVisible"
                                                    Value="False" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <ui:FunctionBarLayout Gap="0"/>
                        <!--<templates:GridLayout Gap="0"/>-->
                        <!--<UniformGridLayout Orientation="Horizontal"
                                           ItemsStretch="None"
                                           MinColumnSpacing="0"
                                           ItemsJustification="SpaceAround" />-->
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!--<Border BorderThickness="0"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="2"
                                        Margin="0,1,0,0"
                                        Height="1"
                                        Background="{DynamicResource ThemeAlternativeBackgroundBrush}"/>-->
            </Grid>
        </Panel>
    </DataTemplate>

    <!--<DataTemplate DataType="system:String">
        <TextBlock Text="{Binding Text}" />
    </DataTemplate>-->

</ResourceDictionary>